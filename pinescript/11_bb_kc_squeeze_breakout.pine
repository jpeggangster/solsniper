//@version=6
strategy("BB/KC Squeeze Breakout Strategy [BTCUSDT 15m/1H]",
     shorttitle="Squeeze-S",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     pyramiding=0,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     process_orders_on_close=true)

emaLen          = input.int(200,   "EMA Length",         minval=1, group="Trend Filter")
bbLen           = input.int(20,    "BB Length",          minval=1, group="Bollinger Bands")
bbMult          = input.float(2.0, "BB StdDev Mult",     step=0.1, group="Bollinger Bands")
kcLen           = input.int(20,    "KC Length",          minval=1, group="Keltner Channels")
kcMult          = input.float(1.5, "KC ATR Mult",        step=0.1, group="Keltner Channels")
volLen          = input.int(10,    "Volume SMA Length",  minval=1, group="Volume Filter")
squeezeLookback = input.int(5,     "Squeeze Release Lookback (bars)", minval=1, group="Squeeze")
rrRatio         = input.float(1.5, "Risk:Reward Ratio",  step=0.1, minval=0.1, group="Risk Management")

emaColor = input.color(color.orange, "EMA Color", group="Colors")
bbColor  = input.color(color.blue,   "BB Color",  group="Colors")
kcColor  = input.color(color.white,  "KC Color",  group="Colors")

ema200 = ta.ema(close, emaLen)

bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)
upperBB = bbBasis + bbDev
lowerBB = bbBasis - bbDev

kcBasis = ta.ema(close, kcLen)
kcRange = ta.atr(kcLen)
upperKC = kcBasis + kcRange * kcMult
lowerKC = kcBasis - kcRange * kcMult

volumeSMA = ta.sma(volume, volLen)

squeezeOn       = upperBB < upperKC and lowerBB > lowerKC
recentSqueeze   = math.sum(squeezeOn ? 1 : 0, squeezeLookback)[1] > 0
squeezeReleased = recentSqueeze and not squeezeOn

trendUp    = close > ema200
trendDown  = close < ema200
volConfirm = volume > volumeSMA

longCondition  = trendUp   and squeezeReleased and close > upperBB and volConfirm
shortCondition = trendDown and squeezeReleased and close < lowerBB and volConfirm

var float slLevel = na
var float tpLevel = na

if longCondition and strategy.position_size <= 0
    riskDist = close - low
    if riskDist > 0
        slLevel := low
        tpLevel := close + rrRatio * riskDist
        strategy.entry("Long", strategy.long)
        strategy.exit("Long Exit", "Long", stop=slLevel, limit=tpLevel)
        alert("Squeeze: LONG on " + syminfo.ticker + " @ " + str.tostring(close) + " | SL " + str.tostring(slLevel) + " | TP " + str.tostring(tpLevel), alert.freq_once_per_bar_close)

if shortCondition and strategy.position_size >= 0
    riskDist = high - close
    if riskDist > 0
        slLevel := high
        tpLevel := close - rrRatio * riskDist
        strategy.entry("Short", strategy.short)
        strategy.exit("Short Exit", "Short", stop=slLevel, limit=tpLevel)
        alert("Squeeze: SHORT on " + syminfo.ticker + " @ " + str.tostring(close) + " | SL " + str.tostring(slLevel) + " | TP " + str.tostring(tpLevel), alert.freq_once_per_bar_close)

inTrade = strategy.position_size != 0

plot(ema200, "EMA 200", color=emaColor, linewidth=2)
bbU = plot(upperBB, "BB Upper", color=bbColor)
bbL = plot(lowerBB, "BB Lower", color=bbColor)
fill(bbU, bbL, color=color.new(bbColor, 93), title="BB Fill")
plot(upperKC, "KC Upper", color=kcColor)
plot(lowerKC, "KC Lower", color=kcColor)

plot(inTrade ? slLevel : na, "Stop Loss",   color=color.red,   style=plot.style_linebr, linewidth=1)
plot(inTrade ? tpLevel : na, "Take Profit", color=color.green, style=plot.style_linebr, linewidth=1)

plotshape(squeezeOn, title="Squeeze On", style=shape.circle, location=location.bottom,
     color=color.new(color.gray, 0), size=size.tiny)
plotshape(longCondition, title="Long Signal", style=shape.labelup, location=location.belowbar,
     color=color.new(color.green, 0), text="Long", textcolor=color.white, size=size.small)
plotshape(shortCondition, title="Short Signal", style=shape.labeldown, location=location.abovebar,
     color=color.new(color.red, 0), text="Short", textcolor=color.white, size=size.small)
