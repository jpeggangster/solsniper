# ── OS / editor noise ──
.DS_Store
**/.DS_Store

# ── secrets & auth state ──
# *.session already covers the session DB; the journal is a separate file that
# can hold the same auth material.
*.session-journal

# ── runtime state (per-wallet, not code) ──
hood_positions*.json
hood_seen.json
control_commands.json
ema_watchlist.json
