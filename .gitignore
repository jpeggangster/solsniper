# ── rotated logs ("*.log" does not match "x.log.1") ──
*.log.*

# ── recorded data & generated output ──
*.jsonl
ema_chart_*.html

# ── local backups taken while refactoring ──
*.ema-backup
*.bak
*.bak.*

# ── vendored third-party checkout (922 MB, has its own repo) ──
Vibe-Trading/

# ── node deps for the extension's dev tests ──
node_modules/
